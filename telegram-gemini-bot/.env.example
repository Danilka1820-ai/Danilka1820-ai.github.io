# Скопируйте этот файл в .env и заполните своими значениями.

# Токен бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ID или @username канала, куда бот будет публиковать посты.
# Бот должен быть добавлен в канал как администратор с правом публикации.
CHANNEL_ID=

# Обязательный numeric Telegram user id владельца. Только этот пользователь
# сможет обращаться к Gemini и управлять публикациями в канале.
# Узнать свой id можно, например, у бота @userinfobot.
ADMIN_ID=

# Максимальное ожидание обработки фото/видео/аудио на стороне Gemini.
GEMINI_FILE_TIMEOUT_SECONDS=120
