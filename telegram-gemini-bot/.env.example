# Скопируйте этот файл в .env и заполните своими значениями.

# Токен бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ xAI API: https://console.x.ai
XAI_API_KEY=

# ID или @username канала, куда бот будет публиковать посты.
# Бот должен быть добавлен в канал как администратор с правом публикации.
CHANNEL_ID=

# Обязательный numeric Telegram user id владельца. Только этот пользователь
# сможет обращаться к Grok и управлять публикациями в канале.
# Узнать свой id можно, например, у бота @userinfobot.
ADMIN_ID=

# Максимальное ожидание ответа Grok (текст/картинка) и расшифровки звука.
GROK_FILE_TIMEOUT_SECONDS=120

# Необязательно: переопределить модели, если xAI переименует/обновит их
# (умолчания — в bot.py, GROK_TEXT_MODEL / GROK_VISION_MODEL).
# GROK_TEXT_MODEL=grok-4
# GROK_VISION_MODEL=grok-2-vision-latest
